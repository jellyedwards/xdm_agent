GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west2
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_API_KEY=

GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_VERTEX_SEARCH_APP_ID=

UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREEPIK_API_KEY=
SERPAPI_API_KEY=

# Open cultural/scientific image sources mirrored from xdm_server. Most are
# keyless (vanda, artic, cleveland, wellcome, loc, gbif, openverse, openi,
# rijksmuseum) and need nothing here. These three need the same free keys
# xdm_server already uses — copy the values from xdm_server/.env:
HARVARD_ART_API_KEY=
BHL_API_KEY=
FLICKR_API_KEY=
FLICKR_SECRET=     # only the key is used for public photo search; secret kept for completeness

STORAGE_BACKEND=memory
FIRESTORE_DATABASE=(default)

XDM_SERVER_URL=https://api.designxdm.com
XDM_SERVER_TOKEN=

# Firebase admin SDK for verifying user tokens server-side. Same
# FIREBASE_SERVICE_ACCOUNT env var that xdm_server uses (base64-encoded
# service account JSON). If unset, the agent runs in DEV_AUTH_ALLOW mode
# where every request is the "dev" user — fine for local single-user dev.
FIREBASE_SERVICE_ACCOUNT=
DEV_AUTH_ALLOW=1

# Agent identity used when calling xdm_server's mint_token endpoint for
# autonomous publishing. The secret must match the value xdm_server has
# in its AGENT_CLIENT_SECRETS map (format: "xdm_agent_v1:<secret>,...").
AGENT_CLIENT_ID=xdm_agent_v1
AGENT_CLIENT_SECRET=

# Public demo gate. When PUBLIC_MODE=1, the expensive endpoints (/mindset,
# /mindset/{id}/dossier, /hunt) require either a signed-in design xdm user or
# a valid access code, and are subject to daily quotas. Off (0) = fully ungated
# for local/single-tenant use. Judges reach the demo via a magic link:
#   https://<host>/ui/index.html?code=<one of JUDGE_ACCESS_CODES>
PUBLIC_MODE=0
JUDGE_ACCESS_CODES=          # comma-separated, e.g. "GFS-JUDGE-2026,PREVIEW-1"

# Daily quotas (only enforced when PUBLIC_MODE=1).
QUOTA_DAILY_HUNTS=20         # per browser session, per day
QUOTA_DAILY_MINDSETS=20      # per browser session, per day
QUOTA_DAILY_GLOBAL=600       # total expensive ops across everyone — wallet backstop

PORT=8080
