GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west2
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_API_KEY=

GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_VERTEX_SEARCH_APP_ID=

UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
FREEPIK_API_KEY=
SERPAPI_API_KEY=

STORAGE_BACKEND=memory
FIRESTORE_DATABASE=(default)

XDM_SERVER_URL=https://api.designxdm.com
XDM_SERVER_TOKEN=

# Firebase admin SDK for verifying user tokens server-side. Same
# FIREBASE_SERVICE_ACCOUNT env var that xdm_server uses (base64-encoded
# service account JSON). If unset, the agent runs in DEV_AUTH_ALLOW mode
# where every request is the "dev" user — fine for local single-user dev.
FIREBASE_SERVICE_ACCOUNT=
DEV_AUTH_ALLOW=1

# Agent identity used when calling xdm_server's mint_token endpoint for
# autonomous publishing. The secret must match the value xdm_server has
# in its AGENT_CLIENT_SECRETS map (format: "xdm_agent_v1:<secret>,...").
AGENT_CLIENT_ID=xdm_agent_v1
AGENT_CLIENT_SECRET=

PORT=8080
